<?xml version="1.0" encoding="utf-8"?>
<!--
  FTP Publish Profile for SiteASP.net
  Use this profile when Web Deploy (WMSVC port 8172) is unavailable.
  
  BEFORE USING: Fill in your FTP credentials from the SiteASP control panel:
    - FtpPassiveMode:   true (recommended for most firewalls)
    - UserName:         your FTP username (usually same as site68178)
    - Password:         your FTP password from the SiteASP panel
    - PublishUrl:       ftp://site68178.siteasp.net  (confirm in your panel)
    - SiteUrlToLaunchAfterPublish: http://cira-pm.runasp.net/
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FTP</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://cira-pm.runasp.net/</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>

    <!-- FTP Connection Settings — update these with your SiteASP credentials -->
    <PublishUrl>ftp://site68178.siteasp.net</PublishUrl>
    <FtpSiteUrlToLaunchAfterPublish>http://cira-pm.runasp.net/</FtpSiteUrlToLaunchAfterPublish>
    <FtpPassiveMode>True</FtpPassiveMode>
    <UserName>site68178</UserName>
    <!-- Password is stored in user secrets / credentials manager, not here -->

    <!-- Target: deploy to the wwwroot of the site -->
    <FtpDestinationUrl>ftp://site68178.siteasp.net/site/wwwroot</FtpDestinationUrl>

    <!-- Build settings matching the Web Deploy profile -->
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
